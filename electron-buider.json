{
    "appId": "Music-App",
    "files": [
        "dist-electron",
        "dist-react",
        "public/**/*"
    ],
    "extraFiles": [
        {
            "from": "public",
            "to": "public",
            "filter": ["**/*"]
        }
    ],
    "icon": "./Icon.png",
    "protocols": [
        {
            "name": "Music App",
            "schemes": ["music-app"]
        }
    ],
    "mac": {
        "target": "dmg"
    },
    "linux": {
        "target": "AppImage",
        "category": "Utility"
    },
    "win": {
        "target": [
            "portable",
            "msi"
        ]
    }
}